# Frontend environment variables.
# Copy this file to .env.local and change the values you need.
# .env.local is gitignored, so your own settings stay off GitHub.

# Where the browser sends API calls.
# Leave it as /api/v1 in development -- Vite proxies that path to Django, which
# keeps the browser on one origin so the login cookie works.
VITE_API_BASE_URL=/api/v1

# Which backend the dev proxy points at. Change this if Django is not on 8000.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000

# Shows the demo login buttons on the sign-in page.
# Only turn this on for a public demo site. It prints working credentials on
# the login page, including an admin account that can edit the catalogue and
# change order status. Leave it unset for anything real.
VITE_SHOW_DEMO_CREDENTIALS=false
