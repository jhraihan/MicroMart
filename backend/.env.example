# ---------------------------------------------------------------------------
# Environment variables (PRD §15.3). Copy to .env and fill in.
# .env is gitignored -- never commit real values.
# ---------------------------------------------------------------------------

# Core
DJANGO_SECRET_KEY=generate-a-unique-key-per-environment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database -- MySQL 8, InnoDB, utf8mb4
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3307/ecom

# Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# SSLCommerz (PRD §14 Q1 -- merchant approval pending; sandbox until then)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=True

# Transactional email (PRD §14 Q9 -- provider not yet chosen)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@example.com

# Cache. Throttle counters live here, so in production this must be a shared
# backend -- the default is per-process and every rate limit would silently
# multiply by the number of Gunicorn workers.
# CACHE_URL=redis://127.0.0.1:6379/1

# Rate limits. The defaults in config/settings/base.py are the real ones;
# these exist so a limit can be exercised or relaxed without editing settings.
# ANON_THROTTLE_RATE=120/min
# USER_THROTTLE_RATE=300/min
# AUTH_THROTTLE_RATE=10/min

# Seconds before an outgoing email gives up. Unset, a hung mail server can
# hold a worker for minutes.
EMAIL_TIMEOUT=10

# Media storage: local | s3
MEDIA_STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
# For S3-compatible stores such as Cloudflare R2 (region "auto"):
# AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=pub-<id>.r2.dev

# ---------------------------------------------------------------------------
# Production only -- see docs/DEPLOY-RENDER.md
# ---------------------------------------------------------------------------
# Managed MySQL over TLS: path to the provider's CA certificate. Required when
# DATABASE_URL ends in ?ssl-mode=REQUIRED.
# DB_SSL_CA=/etc/secrets/ca.pem

# Read by backend/scripts/start.sh when the container starts.
# SEED_ON_START=true            # seed demo accounts + catalogue (idempotent)
# DEMO_ADMIN_PASSWORD=          # required with SEED_ON_START; never the README default
# FETCH_MEDIA_ON_START=true     # fetch Wikimedia photography in the background
# WEB_CONCURRENCY=2             # Gunicorn workers
